{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wd-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "wd-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WD_TEST=1",
        "PORT=3200",
        "node",
        "server.js"
      ],
      "port": 3200
    },
    {
      "name": "wd-fast",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "WD_TEST=1",
        "WD_FAST=1",
        "PORT=3300",
        "node",
        "server.js"
      ],
      "port": 3300
    },
    {
      "name": "wd-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3400",
        "--directory",
        "web"
      ],
      "port": 3400
    }
  ]
}